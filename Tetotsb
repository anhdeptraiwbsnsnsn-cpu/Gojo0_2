-- 4. LOGIC SUIRYU VOID KILL (BẬT ON -> BẤM SKILL 2 SẼ TP)
--------------------------------------------------------------------------------
local suiryuVoidEnabled = false

StartButton.MouseButton1Click:Connect(function()
    suiryuVoidEnabled = not suiryuVoidEnabled
    if suiryuVoidEnabled then
        StartButton.Text = "SUIRYU VOID: ON"
        StartButton.TextColor3 = Color3.fromRGB(50, 255, 50)
    else
        StartButton.Text = "SUIRYU VOID: OFF"
        StartButton.TextColor3 = Color3.fromRGB(255, 50, 50)
    end
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if suiryuVoidEnabled and input.KeyCode == Enum.KeyCode.Two then
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        task.wait(0.1)

        local targetPlayers = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local tHumanoid = p.Character:FindFirstChildOfClass("Humanoid")
                if tHumanoid and tHumanoid.Health > 0 then
                    table.insert(targetPlayers, p)
                    if #targetPlayers >= 6 then break end
                end
            end
        end

        for _, target in ipairs(targetPlayers) do
            stickToTarget(target, 0.2)
        end

        stopVelocity(hrp)
        hrp.CFrame = CFrame.new(0, -9995, 0)
        task.wait(0.05)
        stopVelocity(hrp)
    end
end)

