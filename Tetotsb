-- 5. LOGIC FARM ULT
--------------------------------------------------------------------------------
local farmUltEnabled = false
local farmTarget = nil

RunService.Stepped:Connect(function()
    if farmUltEnabled then
        local myChar = LocalPlayer.Character
        local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")

        if not farmTarget or not farmTarget.Character or not farmTarget.Character:FindFirstChild("HumanoidRootPart") or (farmTarget.Character:FindFirstChildOfClass("Humanoid") and farmTarget.Character:FindFirstChildOfClass("Humanoid").Health <= 0) then
            farmTarget = getTargetPlayer()
        end

        if farmTarget and farmTarget.Character and myHrp then
            local targetHrp = farmTarget.Character:FindFirstChild("HumanoidRootPart")
            if targetHrp then
                for _, part in ipairs(myChar:GetChildren()) do
                    if part:IsA("BasePart") then part.CanCollide = false end
                end
                stopVelocity(myHrp)

                local backPos = targetHrp.CFrame * CFrame.new(0, 1.5, 4)
                local lookCFrame = CFrame.lookAt(backPos.Position, targetHrp.Position) * CFrame.Angles(math.rad(-45), 0, 0)
                
                myHrp.CFrame = lookCFrame
            end
        end
    end
end)

FarmUltButton.MouseButton1Click:Connect(function()
    farmUltEnabled = not farmUltEnabled
    if farmUltEnabled then
        farmTarget = getTargetPlayer()
        FarmUltButton.Text = "FARM ULT: ON"
        FarmUltButton.TextColor3 = Color3.fromRGB(50, 255, 50)
    else
        farmTarget = nil
        FarmUltButton.Text = "FARM ULT: OFF"
        FarmUltButton.TextColor3 = Color3.fromRGB(255, 50, 50)
    end
end)

