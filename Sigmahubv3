local function GetClosestTarget()
    local closest, minDist = nil, math.huge
    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return nil end
    local myPos = myChar.HumanoidRootPart.Position

    for _, v in ipairs(Players:GetPlayers()) do
        if v ~= LocalPlayer and v.Character and v.Character:FindFirstChild("HumanoidRootPart") and v.Character:FindFirstChild("Humanoid") then
            if v.Character.Humanoid.Health > 0 then
                local dist = (v.Character.HumanoidRootPart.Position - myPos).Magnitude
                if dist < minDist then
                    minDist = dist
                    closest = v
                end
            end
        end
    end
    return closest
end

----------------------------------------------------
-- ADVANCED FLING & UN-FLING LOGIC
----------------------------------------------------
local function stopFling(State)
    if State then State.active = false end
end

local function unFling(oldPosition, savedFPDH)
    local Character = LocalPlayer.Character
    local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
    local RootPart = Humanoid and Humanoid.RootPart

    if Humanoid then
        workspace.CurrentCamera.CameraSubject = Humanoid
        Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
        pcall(function() Humanoid:ChangeState(Enum.HumanoidStateType.GettingUp) end)
    end

    if RootPart and oldPosition then
        RootPart.CFrame = oldPosition
        Character:PivotTo(oldPosition)
        
        for _, part in ipairs(Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.AssemblyLinearVelocity = Vector3.zero
                part.AssemblyAngularVelocity = Vector3.zero
            end
        end
    end

    pcall(function()
        local currentFPDH = workspace.FallenPartsDestroyHeight
        if currentFPDH ~= currentFPDH or currentFPDH == 0/0 then
            workspace.FallenPartsDestroyHeight = savedFPDH or -500
        end
    end)
end

local function SkidFling(TargetPlayer)
    if currentFlingState.active then
        stopFling(currentFlingState)
        task.wait(0.1)
    end

    currentFlingState = { active = true }
    local State = currentFlingState

    local Character = LocalPlayer.Character
    local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
    local RootPart = Humanoid and Humanoid.RootPart
    local TCharacter = TargetPlayer and TargetPlayer.Character

    if not TCharacter or not Character or not Humanoid or not RootPart then return end

    local THumanoid = TCharacter:FindFirstChildOfClass("Humanoid")
    local TRootPart = THumanoid and THumanoid.RootPart
    local THead = TCharacter:FindFirstChild("Head")

    if THumanoid and THumanoid.Sit then return end
    if not TCharacter:FindFirstChildWhichIsA("BasePart") then return end

    if THead then
        workspace.CurrentCamera.CameraSubject = THead
    elseif THumanoid then
        workspace.CurrentCamera.CameraSubject = THumanoid
    end

    if RootPart.Velocity.Magnitude < 50 then
        currentFlingOldPos = RootPart.CFrame
    end

    currentSavedFPDH = workspace.FallenPartsDestroyHeight
    workspace.FallenPartsDestroyHeight = 0 / 0

    local safeY = currentFlingOldPos and currentFlingOldPos.Position.Y or 0
    local voidWatchdog
    voidWatchdog = RunService.Heartbeat:Connect(function()
        if not State.active or not RootPart or not RootPart.Parent then 
            if voidWatchdog then voidWatchdog:Disconnect() end
            return 
        end
        if RootPart.Position.Y < safeY - 300 then
            pcall(function()
                RootPart.CFrame = CFrame.new(RootPart.Position.X, safeY + 10, RootPart.Position.Z)
                RootPart.AssemblyLinearVelocity = Vector3.zero
                RootPart.AssemblyAngularVelocity = Vector3.zero
            end)
        end
    end)

    local baseV = 9e7 * Tune.Power
    local baseRV = 9e8 * Tune.Power
    local D = math.max(1, math.floor(Tune.Density))

    local function hit(BasePart, offsetY, offsetZ)
        if not State.active then return end
        local targetCF = CFrame.new(BasePart.Position + Vector3.new(0, offsetY, offsetZ))
        RootPart.CFrame = targetCF
        Character:PivotTo(targetCF)
        RootPart.AssemblyLinearVelocity = Vector3.new(baseV, baseV, baseV)
        RootPart.AssemblyAngularVelocity = Vector3.new(baseRV, baseRV, baseRV)
    end

    local function SFBasePart(BasePart)
        local t0 = tick()
        local up = true
        repeat
            if not State.active or not RootPart or not THumanoid or not RootPart.Parent then break end
            local yOff = up and 1.5 or -1.5
            up = not up
            for _ = 1, D do
                if not State.active then break end
                hit(BasePart, yOff, 0)
                RunService.Stepped:Wait()
                if not RootPart.Parent then break end
            end
        until tick() > t0 + Tune.Duration or not State.active
    end

    Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false)

    if TRootPart then
        SFBasePart(TRootPart)
    elseif THead then
        SFBasePart(THead)
    end

    stopFling(State)
    if voidWatchdog then voidWatchdog:Disconnect() end
    unFling(currentFlingOldPos, currentSavedFPDH)
end

-- Logic Auto Bypass AC
local function StartAutoBypassAC()
    local targetPos = Vector3.new(-120, 210, -200)

    bypassACThread = task.spawn(function()
        while bypassACEnabled do
            local char = LocalPlayer.Character
            if not char or not char:FindFirstChild("HumanoidRootPart") or not char:FindFirstChild("Humanoid") then
                task.wait(1)
                continue
            end

            if char.Humanoid.Health <= 0 then
                LocalPlayer.CharacterAdded:Wait()
                task.wait(1)
                continue
            end

            local hrp = char.HumanoidRootPart
            for _, p in pairs(char:GetChildren()) do
                if p:IsA("BasePart") then p.CanCollide = false end
            end

            hrp.CFrame = CFrame.new(targetPos)

            task.wait(0.5)

            if not bypassACEnabled then break end

            if char and char:FindFirstChild("HumanoidRootPart") then
                local currentPos = char.HumanoidRootPart.Position
                local distToTarget = (currentPos - targetPos).Magnitude

                if distToTarget < 15 then
                    Fluent:Notify({ Title = "Bypass AC", Content = "Thành công!", Duration = 3 })
                    bypassACEnabled = false
                    break
                else
                    pcall(function()
                        ReplicatedStorage.Knit.Knit.Services.JoinService.RE.Reset:FireServer()
                    end)
                    LocalPlayer.CharacterAdded:Wait()
                    task.wait(2)
                end
            end
        end
    end)
end

