-- LOGIC ORBIT TAM GIÁC
----------------------------------------------------
local orbitAngle = 0
RunService.Heartbeat:Connect(function(dt)
    if orbitLockEnabled and lockTargetPlayer and lockTargetPlayer.Character and lockTargetPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local myChar = LocalPlayer.Character
        if myChar and myChar:FindFirstChild("HumanoidRootPart") then
            local targetHrp = lockTargetPlayer.Character.HumanoidRootPart
            
            orbitAngle = orbitAngle + dt * 14

            local side = math.floor((orbitAngle / (math.pi * 2 / 3))) % 3
            local radius = 5.5

            local offsets = {
                Vector3.new(0, 0, -radius),
                Vector3.new(radius * 0.866, 0, radius * 0.5),
                Vector3.new(-radius * 0.866, 0, radius * 0.5)
            }

            local currentOffset = offsets[side + 1]
            local targetPos = targetHrp.Position + (targetHrp.CFrame:VectorToWorldSpace(currentOffset))

            myChar.HumanoidRootPart.CFrame = CFrame.new(targetPos, targetHrp.Position)
        end
    end
end)

