local function executeTPAll()
    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return end

    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            myChar.HumanoidRootPart.CFrame = p.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 2.5)
            task.wait(0.005)
        end
    end
end

local function isMyGojoDomainActive()
    local char = LocalPlayer.Character
    if not char then return false end

    for _, obj in ipairs(char:GetDescendants()) do
        local nameLower = obj.Name:lower()
        if nameLower:find("domain") or nameLower:find("infinite") or nameLower:find("unlimited") or nameLower:find("void") then
            return true
        end
    end
    return false
end

CombatTab:AddToggle("KillAllToggle", {
    Title = "teto kill all",
    Default = false,
    Callback = function(Value)
        killAllEnabled = Value
        if killAllEnabled then
            task.spawn(function()
                local domainStartTime = nil

                while killAllEnabled do
                    local now = os.clock()

                    if isMyGojoDomainActive() then
                        if not domainStartTime then
                            domainStartTime = now
                        elseif (now - domainStartTime) >= 1.0 then
                            Fluent:Notify({ Title = "Teto Kill All", Content = "Lãnh Địa Gojo kích hoạt đủ 1s! Bắt đầu TP ALL...", Duration = 3 })
                            executeTPAll()
                            domainStartTime = nil
                        end
                    else
                        domainStartTime = nil
                    end
                    
                    task.wait(0.03)
                end
            end)
        end
    end
})

CombatTab:AddButton({
    Title = "Bypass AC (Thử nghiệm)",
    Callback = function()
        local char = LocalPlayer.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then return end

        local target = lockTargetPlayer
        if not target or not target.Character or not target.Character:FindFirstChild("HumanoidRootPart") then
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    target = p
                    break
                end
            end
        end

        if not target then
            Fluent:Notify({ Title = "Bypass AC", Content = "Chưa chọn Target!", Duration = 3 })
            return
        end

        task.spawn(function()
            local hrp = char.HumanoidRootPart
            local oldPos = hrp.Position
            local targetHrp = target.Character.HumanoidRootPart
            local behindCFrame = targetHrp.CFrame * CFrame.new(0, 0, 2.5)
            
            hrp.CFrame = behindCFrame
            task.wait(0.25)

            local distFromOld = (hrp.Position - oldPos).Magnitude
            local distFromBehind = (hrp.Position - behindCFrame.Position).Magnitude

            if distFromBehind < 2.5 and distFromOld > 5 then
                Fluent:Notify({ Title = "Bypass AC", Content = "Bypass AC: Thành Công!", Duration = 3 })
            else
                Fluent:Notify({ Title = "Bypass AC", Content = "Bypass AC: Thất Bại! Đang Reset...", Duration = 3 })
                
                pcall(function()
                    ReplicatedStorage.Knit.Knit.Services.JoinService.RE.Reset:FireServer()
                end)
            end
        end)
    end
})

