-- LOGIC DRAWING ESP
local ESPData = {}

local function createESP(player)
    if ESPData[player] then return end
    
    local data = {
        Box = Drawing.new("Square"),
        SkeletonLines = {}
    }
    
    data.Box.Color = Color3.fromRGB(180, 80, 255)
    data.Box.Thickness = 1.5
    data.Box.Filled = false
    data.Box.Visible = false

    for i = 1, 10 do
        local line = Drawing.new("Line")
        line.Color = Color3.fromRGB(0, 255, 255)
        line.Thickness = 1.5
        line.Visible = false
        table.insert(data.SkeletonLines, line)
    end

    ESPData[player] = data
end

local function removeESP(player)
    if ESPData[player] then
        ESPData[player].Box:Remove()
        for _, line in ipairs(ESPData[player].SkeletonLines) do line:Remove() end
        ESPData[player] = nil
    end
end

for _, p in ipairs(Players:GetPlayers()) do
    if p ~= LocalPlayer then createESP(p) end
end

Players.PlayerAdded:Connect(function(p)
    if p ~= LocalPlayer then createESP(p) end
end)

Players.PlayerRemoving:Connect(removeESP)

RunService.RenderStepped:Connect(function()
    for player, data in pairs(ESPData) do
        local char = player.Character
        if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
            local hrp = char.HumanoidRootPart
            local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)

            if esp2DEnabled and onScreen then
                local head = char:FindFirstChild("Head")
                if head then
                    local headPos = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
                    local legPos = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
                    
                    local height = math.abs(headPos.Y - legPos.Y)
                    local width = height / 1.5

                    data.Box.Size = Vector2.new(width, height)
                    data.Box.Position = Vector2.new(pos.X - width / 2, pos.Y - height / 2)
                    data.Box.Visible = true
                else
                    data.Box.Visible = false
                end
            else
                data.Box.Visible = false
            end

            if skeletonEnabled and onScreen then
                local head = char:FindFirstChild("Head")
                local torso = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
                local leftArm = char:FindFirstChild("Left Arm") or char:FindFirstChild("LeftHand")
                local rightArm = char:FindFirstChild("Right Arm") or char:FindFirstChild("RightHand")
                local leftLeg = char:FindFirstChild("Left Leg") or char:FindFirstChild("LeftFoot")
                local rightLeg = char:FindFirstChild("Right Leg") or char:FindFirstChild("RightFoot")

                if head and torso then
                    local joints = {
                        {head, torso},
                        {torso, leftArm},
                        {torso, rightArm},
                        {torso, leftLeg},
                        {torso, rightLeg}
                    }

                    for i, joint in ipairs(joints) do
                        if joint[1] and joint[2] then
                            local p1, vis1 = Camera:WorldToViewportPoint(joint[1].Position)
                            local p2, vis2 = Camera:WorldToViewportPoint(joint[2].Position)

                            if vis1 and vis2 then
                                local line = data.SkeletonLines[i]
                                line.From = Vector2.new(p1.X, p1.Y)
                                line.To = Vector2.new(p2.X, p2.Y)
                                line.Visible = true
                            else
                                data.SkeletonLines[i].Visible = false
                            end
                        else
                            data.SkeletonLines[i].Visible = false
                        end
                    end
                end
            else
                for _, line in ipairs(data.SkeletonLines) do line.Visible = false end
            end
        else
            data.Box.Visible = false
            for _, line in ipairs(data.SkeletonLines) do line.Visible = false end
        end
    end
end)

